# Copy this file to .env and fill in your database connection.
# .env is gitignored — never commit real credentials.
#
# Local Postgres: the defaults baked into the scripts already work, so a .env is optional.
# Azure Postgres: set these (host + user come from the Azure portal; you chose the password).

DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=disneywaits
DB_USER=disney
DB_PASSWORD=your-strong-password
DB_SSLMODE=require
